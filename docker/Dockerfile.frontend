# Stage 1: compile the Rust crate to WebAssembly. The generated
# lib/wasm_connect*.{js,d.ts,wasm} files are gitignored, so they must be built
# here rather than expected from the build context.
FROM node:22-bookworm-slim AS wasm-builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    build-essential \
    pkg-config \
    git \
    && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh
RUN rustup target add wasm32-unknown-unknown
WORKDIR /app
COPY frontend/wasm-connectivity/ ./frontend/wasm-connectivity/
WORKDIR /app/frontend/wasm-connectivity
# `make build` runs wasm-pack and appends lib/patch.js (get_memory/__reset).
RUN make build

FROM node:22-alpine AS builder
WORKDIR /app

COPY --from=gsbio . ./frontend/gsbio-engine/
COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend/gsbio-engine && npm install
RUN cd frontend && npm install

COPY frontend/ ./frontend/
# Overlay the freshly-built wasm artefacts (the context only carries the
# hand-authored lib/*.js files; the wasm-pack outputs are gitignored).
COPY --from=wasm-builder /app/frontend/wasm-connectivity/lib/ ./frontend/wasm-connectivity/lib/
RUN cd frontend/gsbio-engine && npm run build

WORKDIR /app/frontend
RUN npm run build

FROM nginx:alpine
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
EXPOSE 80

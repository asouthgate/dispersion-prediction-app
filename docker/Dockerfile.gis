FROM postgis/postgis:16-3.5

# `postgis` (the metapackage) provides shp2pgsql/raster2pgsql, which the seed
# script needs. bullseye is EOL so its security repo's InRelease is expired;
# Check-Valid-Until=false lets apt-get update proceed anyway.
RUN apt-get update -o Acquire::Check-Valid-Until=false \
    && apt-get install -y --no-install-recommends postgis \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY test/data/seed/seed-test-data.sh /docker-entrypoint-initdb.d/00-seed.sh
RUN chmod +x /docker-entrypoint-initdb.d/00-seed.sh